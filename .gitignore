# Build output
target/
*.class

# Maven wrapper: the script and properties are committed so the build is reproducible
# on a machine with no Maven installed. The downloaded distribution is not.
!.mvn/wrapper/maven-wrapper.properties
.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/*.bak

# Kafka Streams local state. Rebuilt from the topics on startup; never worth committing,
# and stale state from an older topology is actively harmful.
**/kafka-streams/

# Python
analytics/.venv/
__pycache__/
*.py[cod]

# Logs and local env
*.log
.env

# Editors and OS
.idea/
*.iml
.vscode/
.DS_Store

# Local tool permissions, specific to one machine
.claude/settings.local.json

# Terraform
#
# .terraform/ is downloaded provider binaries (hundreds of MB).
# tfstate is environment-specific and routinely contains secrets — it is the single most
# commonly leaked file in infrastructure repos. Real deployments keep it in remote state
# with encryption and locking, never in git.
# .terraform.lock.hcl IS committed: it pins provider versions, like any other lockfile.
infra/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
*.auto.tfvars
terraform.tfvars
